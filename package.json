{
  "name": "beam",
  "private": true,
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @beam/web --filter @beam/runner dev",
    "dev:web": "pnpm --filter @beam/web dev",
    "dev:runner": "pnpm --filter @beam/runner dev",
    "dev:desktop": "pnpm --filter @beam/desktop dev",
    "convex": "convex dev",
    "convex:deploy": "convex deploy -y",
    "probe": "pnpm --filter @beam/runner probe",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm test:backend",
    "test:backend": "vitest run convex/notifications.test.ts convex/mentionTargets.test.ts convex/files.test.ts convex/chats.test.ts convex/compute.test.ts convex/context.test.ts convex/studyDispatch.test.ts convex/runContext.test.ts",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.95",
    "convex": "^1.43.0",
    "jose": "^6.2.10"
  },
  "type": "module"
}
