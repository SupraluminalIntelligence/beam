{
  "name": "@beam/desktop",
  "version": "0.0.8",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --external:electron --format=cjs --outfile=dist/main.cjs && esbuild src/preload.ts --bundle --platform=node --external:electron --format=cjs --outfile=dist/preload.cjs",
    "dev": "pnpm build && BEAM_DEV=1 electron .",
    "dist": "pnpm build && pnpm build:runner && pnpm build:web && electron-builder --mac --arm64 --x64",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build:runner": "esbuild ../runner/src/cli.ts --bundle --platform=node --format=esm --outfile=dist/runner.mjs --banner:js=\"import { createRequire as __beamRequire } from 'node:module'; const require = __beamRequire(import.meta.url);\" --log-level=warning && cp ../runner/src/compute/worker.mjs dist/worker.mjs",
    "build:web": "pnpm --filter @beam/web build && rm -rf dist/web && cp -R ../web/dist dist/web",
    "release": "pnpm build && pnpm build:runner && pnpm build:web && sh ../../scripts/release-mac.sh"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0"
  },
  "build": {
    "appId": "ai.supraluminal.beam",
    "productName": "Beam",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**"
    ],
    "asarUnpack": [
      "dist/runner.mjs",
      "dist/worker.mjs"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "icon": "build/beam.icns"
    },
    "dmg": {
      "artifactName": "Beam-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SupraluminalAI",
        "repo": "beam-releases",
        "releaseType": "draft"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
